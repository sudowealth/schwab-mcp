/**
 * Example personal/local development configuration
 *
 * Instructions:
 * 1. Copy this file to wrangler.jsonc (for your personal deployment)
 * 2. Replace YOUR_KV_NAMESPACE_ID_HERE with your actual KV namespace ID
 * 3. Optionally change the name to avoid conflicts with others
 *
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "schwab-mcp-personal", // Change this to a unique name for your deployment
	"main": "src/index.ts",
	"compatibility_date": "2025-04-17",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"new_sqlite_classes": ["MyMCP"],
			"tag": "v1",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "MyMCP",
				"name": "MCP_OBJECT",
			},
		],
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "YOUR_KV_NAMESPACE_ID_HERE", // Replace with your actual KV namespace ID
		},
	],
	// Per-IP rate limit for the public auth endpoints (/register, /authorize,
	// /token, /callback). Optional: if the binding is absent the worker skips
	// rate limiting. 15 requests/60s comfortably fits a full OAuth login (~5).
	"unsafe": {
		"bindings": [
			{
				"name": "AUTH_RATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1001", // Any integer unique among this worker's ratelimit bindings
				"simple": { "limit": 15, "period": 60 },
			},
		],
	},
	"observability": {
		"enabled": false, // Set to true for production monitoring (has costs)
	},
	"dev": {
		"port": 8788,
		"local_protocol": "https",
		"upstream_protocol": "https",
	},
}
